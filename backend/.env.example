# SolarIQ backend environment variables
# Copy this file to .env and fill in values, or export these in your shell.

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5433/solariq
DB_USERNAME=gangaKrishnan
DB_PASSWORD=

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Google Gemini API (leave empty to use deterministic fallback)
GEMINI_API_KEY=

# Basic auth for /api/v1/leads and PATCH endpoints
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
